    if c, ok := ctx.(*gin.Context); ok {
        value, _ := c.Get(strictGinJSONDecodeErrorKey)
        err, _ := value.(error)
        return err
    }
    return nil
}

func NewStrictHandler(ssi StrictServerInterface) ServerInterface {
    return &strictHandler{ssi: ssi}
}

type strictHandler struct {
    ssi StrictServerInterface
}

func (sh *strictHandler) reportError(c *gin.Context, operation string, err error, statusCode int) {
    value, _ := c.Get(ginOperationErrorHandlerKey)
    handler, _ := value.(GinOperationErrorHandler)
    reportGinOperationError(c, operation, err, statusCode, handler)
}

func matchesStrictGinContentType(want, got string) bool {
    if want == got {
        return true
    }
    before, after, hasWildcard := strings.Cut(want, "*")
    return hasWildcard && strings.HasPrefix(got, before) && strings.HasSuffix(got, after)
}

